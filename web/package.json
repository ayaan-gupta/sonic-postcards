{
  "name": "sonic-postcards-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Record ten seconds of where you are and pin it to a shared map as a postcard.",
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-4106}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-4106}",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "perf": "tsx scripts/perf-map.ts",
    "e2e": "tsx scripts/e2e.ts",
    "shots": "tsx scripts/screenshots.ts",
    "demo": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "gifenc": "^1.0.3",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
