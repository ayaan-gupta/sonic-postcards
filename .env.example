# Copy to .env to change anything. Every value below is the default; the app
# runs with no .env at all, with no keys and no network.

# Ports (3000, 8000 and 5432 are deliberately avoided).
WEB_PORT=4106
API_PORT=8106
DB_PORT=5506

# Postgres with PostGIS and pgvector. `make db` runs it in Docker on DB_PORT.
DATABASE_URL=postgresql://sonic:sonic@127.0.0.1:5506/sonic

# Where the web server finds the API (read at runtime, not at build time).
API_URL=http://127.0.0.1:8106

# Basemap: "auto" tries OpenFreeMap and falls back to the bundled outlines,
# "offline" never touches the network, or give any MapLibre style URL.
# Read when the web app is built or started in dev mode.
NEXT_PUBLIC_MAP_STYLE=auto

# Clips and postcard images. "local" keeps them in STORAGE_DIR. "s3" needs
# `pip install boto3` and the S3_* values, and has not been run against a real bucket.
STORAGE_BACKEND=local
# STORAGE_DIR=./storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Design-time art. Files in assets/generated win over assets/interim.
# ASSETS_DIR=./assets

# Audio pipeline.
SPEECH_THRESHOLD=0.6
MIN_CLIP_SECONDS=8
MAX_UPLOAD_BYTES=8000000

# Place names: "offline" (bundled GeoNames table) or "nominatim" (OpenStreetMap, online).
GEOCODER=offline
# Weather: "none" or "open-meteo" (keyless, online).
WEATHER=none

# Postcard art: "procedural" is the built-in painter. "openai" calls an
# OpenAI-compatible images API and is untested against the live service.
IMAGE_PROVIDER=procedural
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1

# Moderation.
DAILY_POSTCARD_LIMIT=10
REPORT_HIDE_THRESHOLD=3
# Set a long random value to enable DELETE /api/admin/postcards/{id}. Empty disables it.
ADMIN_TOKEN=
# Change this in any real deployment; device ids are hashed with it.
DEVICE_SALT=change-me-in-production

# Above this many postcards in view, the database groups pins on a grid.
MAX_PINS=8000
SEED_ON_START=true
